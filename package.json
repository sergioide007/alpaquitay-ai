{
  "name": "alpaquitay-ai",
  "displayName": "Alpaquitay AI",
  "description": "Astra-style AI harness for VS Code: SDLC gates, DORA metrics, debt tracking, diff-first writes, specialist routing, and a Docs agent for Word, Markdown, EPUB and PDF. Privacy-first, GDPR/CCPA compliant.",
  "version": "3.8.2",
  "publisher": "alpaquitay-ai",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "qna": "https://github.com/sergioide007/alpaquitay-ai/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "docx",
    "epub",
    "book-editing",
    "markdown",
    "writing",
    "ai",
    "coding-assistant",
    "spec-driven",
    "scrum",
    "kanban",
    "claude",
    "ollama",
    "local-ai",
    "mcp",
    "skills",
    "privacy",
    "gdpr",
    "harness",
    "sdlc",
    "dora",
    "platform-engineering",
    "astral",
    "specsolid",
    "debt-tracking",
    "diff-first",
    "webgpu",
    "wasm",
    "onnx",
    "gemma",
    "on-device"
  ],
  "license": "MIT",
  "author": {
    "name": "Sergio Perez Ruiz",
    "email": "sergio@specsolid.com",
    "url": "https://www.specsolid.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sergioide007/alpaquitay-ai"
  },
  "bugs": {
    "url": "https://github.com/sergioide007/alpaquitay-ai/issues"
  },
  "homepage": "https://www.specsolid.com/tools/alpaquitay-ai/",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "alpaquitay-ai.open",
        "title": "Open Alpaquitay Hub",
        "category": "Alpaquitay AI",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "alpaquitay-ai.showMenu",
        "title": "Show Alpaquitay Commands",
        "category": "Alpaquitay AI",
        "icon": "$(list-unordered)"
      },
      {
        "command": "alpaquitay-ai.configureProvider",
        "title": "Configure AI Provider",
        "category": "Alpaquitay AI",
        "icon": "$(settings-gear)"
      },
      {
        "command": "alpaquitay-ai.newSpecification",
        "title": "New Specification",
        "category": "Alpaquitay AI",
        "icon": "$(file-add)"
      },
      {
        "command": "alpaquitay-ai.generateFromSpec",
        "title": "Generate from Specification",
        "category": "Alpaquitay AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "alpaquitay-ai.validateAgainstSpec",
        "title": "Validate Against Specification",
        "category": "Alpaquitay AI",
        "icon": "$(pass-filled)"
      },
      {
        "command": "alpaquitay-ai.generateSpecLocal",
        "title": "Generate Specification (Local Model)",
        "category": "Alpaquitay AI",
        "icon": "$(chip)"
      },
      {
        "command": "alpaquitay-ai.clearLocalModelCache",
        "title": "Clear Local Model Cache",
        "category": "Alpaquitay AI",
        "icon": "$(trash)"
      },
      {
        "command": "alpaquitay-ai.show-agent-changes",
        "title": "Show Agent Changes",
        "category": "Alpaquitay AI",
        "icon": "$(comment-discussion)"
      }
    ],
    "configuration": {
      "title": "Alpaquitay AI",
      "properties": {
        "alpaquitay-ai.preferredProvider": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "anthropic",
            "openai",
            "ollama",
            "lmstudio",
            "local-wasm"
          ],
          "enumDescriptions": [
            "Auto: prefiere modelos locales por privacidad",
            "Anthropic Claude",
            "OpenAI GPT",
            "Ollama (local, privado)",
            "LM Studio (local, privado)",
            "Modelo local (WebGPU/Wasm, 100% en tu equipo)"
          ],
          "description": "Proveedor AI preferido. 'auto' selecciona modelos locales primero."
        },
        "alpaquitay-ai.anthropic.model": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "Modelo de Anthropic a usar"
        },
        "alpaquitay-ai.openai.model": {
          "type": "string",
          "default": "gpt-6.1-sol",
          "description": "Modelo de OpenAI a usar"
        },
        "alpaquitay-ai.ollama.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Endpoint del servidor Ollama"
        },
        "alpaquitay-ai.ollama.model": {
          "type": "string",
          "default": "codellama",
          "description": "Modelo Ollama (e.g. codellama, deepseek-coder, mistral, llama3)"
        },
        "alpaquitay-ai.lmstudio.endpoint": {
          "type": "string",
          "default": "http://localhost:1234",
          "description": "Endpoint del servidor LM Studio"
        },
        "alpaquitay-ai.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "maximum": 128000,
          "description": "Máximo de tokens por request AI"
        },
        "alpaquitay-ai.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperatura de respuesta AI (menor = más determinista)"
        },
        "alpaquitay-ai.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enviar estadísticas anónimas de uso. Ningún código ni prompt se envía nunca. Ver PRIVACY.md."
        },
        "alpaquitay-ai.anthropic.baseUrl": {
          "type": "string",
          "default": "https://api.anthropic.com/v1",
          "description": "Base URL de la API de Anthropic (útil para proxies o deployments custom)"
        },
        "alpaquitay-ai.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL de la API de OpenAI (útil para Azure OpenAI o proxies)"
        },
        "alpaquitay-ai.requestTimeout": {
          "type": "number",
          "default": 120000,
          "minimum": 10000,
          "maximum": 600000,
          "description": "Timeout de requests AI en milisegundos (default: 120s)"
        },
        "alpaquitay-ai.skill.maxParallel": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Máximo de sub-skills ejecutados en paralelo en CompositeSkill/ParallelSkill"
        },
        "alpaquitay-ai.mcp.filesystem.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar MCP Filesystem (leer/escribir archivos)"
        },
        "alpaquitay-ai.mcp.git.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar MCP Git (operaciones git)"
        },
        "alpaquitay-ai.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "System prompt global que se inyecta en todas las conversaciones AI"
        },
        "alpaquitay-ai.orgContext": {
          "type": "string",
          "default": "",
          "description": "Nombre o contexto de la organización/equipo para personalizar respuestas"
        },
        "alpaquitay-ai.indexing.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Habilitar indexado del workspace para contexto enriquecido (próximamente)"
        },
        "alpaquitay-ai.specFile": {
          "type": "string",
          "default": "spec.md",
          "description": "Nombre del archivo spec en el workspace (e.g. tasks.md, backlog.md). Si no existe, Alpaquitay busca automáticamente archivos similares."
        },
        "alpaquitay-ai.localEngine.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Permite usar el modelo local (WebGPU/Wasm) como proveedor AI. La primera ejecucion descarga el modelo desde la CDN y pide confirmacion. El comando \"Generate Specification (Local Model)\" funciona aunque esto este desactivado.",
          "scope": "application"
        },
        "alpaquitay-ai.localEngine.cdnBaseUrl": {
          "type": "string",
          "default": "https://alpaquitay.specsolid.com",
          "scope": "application",
          "pattern": "^https?://[^/\\s]+/?$",
          "description": "Origen de la CDN estatica que sirve /models/. Solo se descargan pesos y runtime ONNX; ningun prompt se envia. Solo se lee de la configuracion de usuario (no de la del workspace)."
        },
        "alpaquitay-ai.localEngine.modelId": {
          "type": "string",
          "default": "qwen2.5-coder-1.5b-instruct",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "description": "Carpeta del modelo bajo /models/ en la CDN (debe tener manifest.json y manifest.sig.json). Solo desde la configuracion de usuario.",
          "scope": "application"
        },
        "alpaquitay-ai.localEngine.device": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "webgpu",
            "wasm"
          ],
          "enumDescriptions": [
            "WebGPU si hay GPU compatible; si no, Wasm (CPU)",
            "Solo WebGPU (falla si no hay GPU)",
            "Solo Wasm (CPU, mas lento)"
          ],
          "description": "Backend de inferencia del motor local."
        },
        "alpaquitay-ai.localEngine.maxNewTokens": {
          "type": "number",
          "default": 1024,
          "minimum": 64,
          "maximum": 4096,
          "description": "Maximo de tokens nuevos por generacion local."
        },
        "alpaquitay-ai.localEngine.dtype": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "q4",
            "q4f16",
            "q8",
            "fp16",
            "fp32"
          ],
          "enumDescriptions": [
            "Elige solo: q4f16 si la GPU soporta shader-f16, si no q4",
            "Pesos 4 bits, activaciones fp32 (la opcion segura)",
            "4 bits + fp16: mas rapido pero necesita shader-f16; algunos modelos Gemma dan salida corrupta en fp16",
            "8 bits",
            "fp16 (requiere shader-f16)",
            "fp32 (muy pesado)"
          ],
          "description": "Precision de los pesos. \"auto\" es lo recomendado; fuerza un valor solo si ves salida corrupta o el modelo lo publica."
        },
        "alpaquitay-ai.localEngine.extraTrustedKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          },
          "default": [],
          "scope": "application",
          "description": "Claves publicas Ed25519 (base64, 32 bytes) adicionales para un mirror propio de la CDN. Se suman a las del proyecto; solo desde la configuracion de usuario."
        }
      }
    },
    "keybindings": [
      {
        "command": "alpaquitay-ai.showMenu",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "alpaquitay-ai.open",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "alpaquitay-ai.open"
        },
        {
          "command": "alpaquitay-ai.showMenu"
        },
        {
          "command": "alpaquitay-ai.configureProvider"
        },
        {
          "command": "alpaquitay-ai.newSpecification"
        },
        {
          "command": "alpaquitay-ai.generateFromSpec"
        },
        {
          "command": "alpaquitay-ai.validateAgainstSpec"
        },
        {
          "command": "alpaquitay-ai.generateSpecLocal"
        },
        {
          "command": "alpaquitay-ai.clearLocalModelCache"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:engine",
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "package": "vsce package",
    "package:ci": "vsce package --out alpaquitay-ai-v${npm_package_version}.vsix",
    "publish": "vsce publish",
    "publish:ci": "vsce publish --pat ${VSCE_PAT}",
    "release": "node scripts/release.js",
    "harness:docs": "node scripts/gen-harness-docs.js",
    "build:engine": "node scripts/build-engine.js",
    "typecheck:engine": "tsc -p engine/tsconfig.json",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "cdn:stage": "node scripts/cdn-stage.js",
    "cdn:keygen": "node scripts/cdn-keygen.js",
    "cdn:sign": "node scripts/cdn-sign.js",
    "cdn:verify": "node scripts/cdn-verify.js",
    "manual:build": "node scripts/build-manual.js",
    "manual:check": "node scripts/build-manual.js --check",
    "check:node": "node scripts/check-node-security.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/test/__mocks__/vscode.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/test/**",
      "!src/extension.ts",
      "!src/panel/**",
      "!src/domains/**/model.ts",
      "!src/local/LocalEngineHost.ts",
      "!src/local/GenerateSpecLocal.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 28,
        "functions": 50,
        "lines": 52,
        "statements": 52
      }
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@huggingface/transformers": "^4.3.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.23.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.0.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "markdown-it": "14.1.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  }
}
